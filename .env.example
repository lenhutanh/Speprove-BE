NODE_ENV=development
APP_NAME=Speprove
AUTHOR=
APP_HOST=localhost
APP_PORT=5000
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
# Reverse proxies in front of the app (0 = none)
TRUST_PROXY=0
HTTP_TIMEOUT_MS=30000
AI_TIMEOUT_MS=60000
SHUTDOWN_TIMEOUT_MS=15000

# A replica set is required (transactions)
MONGODB_URI=
DATABASE_NAME=
MONGO_MAX_POOL_SIZE=20
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000

REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
# Optional; takes precedence over the three values above (rediss:// enables TLS)
REDIS_URL=

# At least 32 characters each
ACCESS_TOKEN_SECRET_SIGNATURE=replace-with-a-random-string-of-at-least-32-chars
REFRESH_TOKEN_SECRET_SIGNATURE=replace-with-another-random-string-of-32-chars
ACCESS_TOKEN_LIFE=15m
REFRESH_TOKEN_LIFE=7d
ACCESS_TOKEN_COOKIE_LIFE=15m

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/auth/google/callback

BREVO_API_KEY=
SENDER_EMAIL=no-reply@example.com
SENDER_NAME=Speprove

CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

GROQ_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
